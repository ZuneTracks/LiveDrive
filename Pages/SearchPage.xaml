<Page
    x:Class="LiveDrive.Pages.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:LiveDrive.Models">
    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Search drive" Style="{StaticResource LiveDrivePageTitleStyle}"/>
        <Grid Grid.Row="1" Margin="0,4,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchTextBox" PlaceholderText="Find files and folders" KeyDown="SearchTextBox_KeyDown"/>
            <Button Grid.Column="1" Content="Search" Click="SearchButton_Click" Margin="8,0,0,0"
                    Style="{StaticResource LiveDrivePrimaryButtonStyle}"/>
        </Grid>
        <Grid Grid.Row="2">
            <ListView x:Name="ResultsList" ItemsSource="{x:Bind Results}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:DriveItem">
                        <Border Style="{StaticResource LiveDriveListRowStyle}">
                            <StackPanel>
                                <TextBlock Text="{x:Bind Name}" FontSize="16"/>
                                <TextBlock Text="{x:Bind TypeLabel}" Style="{StaticResource LiveDriveMutedTextStyle}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <ProgressRing IsActive="True" Width="28" Height="28"/>
                <TextBlock Text="Searching…" Style="{StaticResource LiveDriveStateDescriptionStyle}"/>
            </StackPanel>
            <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Search across your OneDrive." Style="{StaticResource LiveDriveStateTitleStyle}"/>
                <TextBlock Text="Sign in first, then enter a file or folder name." Style="{StaticResource LiveDriveStateDescriptionStyle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
