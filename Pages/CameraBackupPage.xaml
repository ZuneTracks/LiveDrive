<Page
    x:Class="LiveDrive.Pages.CameraBackupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:LiveDrive.Models">
    <ScrollViewer>
        <StackPanel Padding="16">
            <TextBlock Text="Camera backup" Style="{StaticResource LiveDrivePageTitleStyle}" Margin="0,0,0,12"/>
            <Border Background="{ThemeResource CalloutBackgroundBrush}" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Manual uploads on Windows 10 Mobile" Foreground="{ThemeResource CalloutForegroundBrush}" FontWeight="SemiBold"/>
                    <TextBlock Text="Legacy Mobile does not provide reliable long-running background transfer for an independent app. LiveDrive keeps this queue visible while the app is open; choose photos or videos manually to back up them now."
                               Foreground="{ThemeResource CalloutForegroundBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <TextBlock Text="Uploads are stored in the LiveDrive Camera Roll folder at the root of your OneDrive. Same-named files are saved as new copies rather than replacing existing files."
                               Foreground="{ThemeResource CalloutForegroundBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button x:Name="ChooseMediaButton" Content="Choose media" Click="ChooseMediaButton_Click" Style="{StaticResource LiveDrivePrimaryButtonStyle}"/>
                <Button x:Name="UploadButton" Content="Upload" Click="UploadQueueButton_Click" Margin="8,0,0,0" Style="{StaticResource LiveDriveSecondaryButtonStyle}"/>
                <Button x:Name="RecentlyUploadedButton" Content="Recently uploaded" Click="RecentlyUploadedButton_Click"
                        Margin="8,0,0,0" Style="{StaticResource LiveDriveSecondaryButtonStyle}"/>
            </StackPanel>
            <StackPanel x:Name="UploadProgressPanel" Visibility="Collapsed" Margin="0,0,0,12">
                <TextBlock x:Name="UploadProgressText" Text="Preparing upload…" Margin="0,0,0,6"/>
                <ProgressBar x:Name="UploadProgress" Minimum="0" Maximum="1" Value="0"/>
            </StackPanel>
            <ListView ItemsSource="{x:Bind Queue}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:BackupItem">
                        <Border Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource SurfaceBorderBrush}"
                                BorderThickness="0,0,0,1" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind Status}" Opacity="0.7"/>
                            <Button Grid.Column="2" Content="X" Click="RemoveQueueItemButton_Click" Margin="8,0,0,0"
                                    MinWidth="32" MinHeight="32" Padding="0" FontWeight="SemiBold"
                                    AutomationProperties.Name="Remove from upload queue"/>
                        </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EmptyText" Text="No media selected yet." Opacity="0.65"/>
        </StackPanel>
    </ScrollViewer>
</Page>
