<Page
    x:Class="LiveDrive.Pages.CollectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:LiveDrive.Models">
    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Collections" Style="{StaticResource LiveDrivePageTitleStyle}"/>
        <Grid Grid.Row="1">
            <ListView ItemsSource="{x:Bind Collections}" IsItemClickEnabled="True" ItemClick="CollectionsList_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:PhotoCollection">
                        <Border Style="{StaticResource LiveDriveListRowStyle}">
                            <StackPanel>
                                <TextBlock Text="{x:Bind Title}" FontSize="17"/>
                                <TextBlock Text="{x:Bind CountLabel}" Style="{StaticResource LiveDriveMutedTextStyle}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="No photo collections yet." Style="{StaticResource LiveDriveStateTitleStyle}"/>
                <TextBlock Text="Open Photos once to build the local photo index."
                           Style="{StaticResource LiveDriveStateDescriptionStyle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
