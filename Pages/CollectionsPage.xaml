<Page
    x:Class="LiveDrive.Pages.CollectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:LiveDrive.Models">
    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Collections" Style="{StaticResource LiveDrivePageTitleStyle}"/>
        <Grid Grid.Row="1">
            <ListView ItemsSource="{x:Bind Collections}" IsItemClickEnabled="True" ItemClick="CollectionsList_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:PhotoCollection">
                        <Border Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource SurfaceBorderBrush}"
                                BorderThickness="0,0,0,1" Padding="12">
                            <StackPanel>
                                <TextBlock Text="{x:Bind Title}" FontSize="17"/>
                                <TextBlock Text="{x:Bind CountLabel}" Foreground="{ThemeResource MutedTextBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="No photo collections yet." FontSize="18" HorizontalAlignment="Center"/>
                <TextBlock Text="Open Photos once to build the local photo index." Opacity="0.65"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,8"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
