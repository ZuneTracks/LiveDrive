<Page
    x:Class="LiveDrive.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="16">
            <TextBlock Text="Account &amp; settings" Style="{StaticResource LiveDrivePageTitleStyle}" Margin="0,0,0,12"/>
            <TextBlock x:Name="AccountStatus" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Sign in with Microsoft" Click="SignInButton_Click" Style="{StaticResource LiveDrivePrimaryButtonStyle}"/>
                <Button Content="Sign out" Click="SignOutButton_Click" Margin="8,0,0,0" Style="{StaticResource LiveDriveSecondaryButtonStyle}"/>
            </StackPanel>
            <ToggleSwitch x:Name="ThemeToggle" Header="Dark mode" Toggled="ThemeToggle_Toggled" Margin="0,0,0,12"/>
            <TextBlock x:Name="ThemeStatus" TextWrapping="Wrap" Opacity="0.75" Margin="0,-8,0,12"/>
            <TextBlock Text="Privacy" FontSize="20" FontWeight="SemiLight" Margin="0,10,0,0"/>
            <TextBlock Text="Tokens are stored in the device PasswordVault. LiveDrive calls Microsoft Graph directly and does not contain a client secret."
                       TextWrapping="Wrap" Opacity="0.75"/>
           <Button x:Name="AboutButton" Content="ABOUT" Click="AboutButton_Click" HorizontalAlignment="Left"
                   Margin="0,20,0,0" Style="{StaticResource LiveDriveSecondaryButtonStyle}"/>
        </StackPanel>
    </ScrollViewer>
</Page>
