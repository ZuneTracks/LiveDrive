<Page
    x:Class="LiveDrive.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="16">
            <TextBlock Text="Account &amp; settings" Style="{StaticResource LiveDrivePageTitleStyle}"/>
            <TextBlock Text="Account" Style="{StaticResource LiveDriveSectionTitleStyle}" Margin="0,0,0,6"/>
            <TextBlock x:Name="AccountStatus" TextWrapping="Wrap" Foreground="{ThemeResource MutedTextBrush}" Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Sign in with Microsoft" Click="SignInButton_Click" Style="{StaticResource LiveDrivePrimaryButtonStyle}"/>
                <Button Content="Sign out" Click="SignOutButton_Click" Margin="8,0,0,0" Style="{StaticResource LiveDriveSecondaryButtonStyle}"/>
            </StackPanel>
            <TextBlock Text="Appearance" Style="{StaticResource LiveDriveSectionTitleStyle}"/>
            <ToggleSwitch x:Name="ThemeToggle" Header="Dark mode" Toggled="ThemeToggle_Toggled" Margin="0,0,0,8"/>
            <TextBlock x:Name="ThemeStatus" TextWrapping="Wrap" Foreground="{ThemeResource MutedTextBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="Privacy" Style="{StaticResource LiveDriveSectionTitleStyle}"/>
            <TextBlock Text="Tokens are stored in the device PasswordVault. LiveDrive calls Microsoft Graph directly and does not contain a client secret."
                       TextWrapping="Wrap" Foreground="{ThemeResource MutedTextBrush}"/>
            <Button x:Name="AboutButton" Content="ABOUT" Click="AboutButton_Click" HorizontalAlignment="Left"
                    Margin="0,20,0,0" Style="{StaticResource LiveDriveQuietButtonStyle}"/>
        </StackPanel>
    </ScrollViewer>
</Page>
