<Page
    x:Class="LiveDrive.Pages.DrivePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:LiveDrive.Models"
    xmlns:helpers="using:LiveDrive.Helpers">
    <Page.Resources>
        <helpers:BooleanToSymbolConverter x:Key="BooleanToSymbolConverter"/>
    </Page.Resources>
    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="My drive" Style="{StaticResource LiveDrivePageTitleStyle}"/>
        <CommandBar Grid.Row="1" DefaultLabelPosition="Right">
            <AppBarButton Icon="Back" Label="Up" Click="UpButton_Click"/>
            <AppBarButton Icon="Refresh" Label="Refresh" Click="RefreshButton_Click"/>
            <AppBarButton Icon="Upload" Label="Upload" Click="UploadButton_Click"/>
            <AppBarSeparator/>
            <AppBarButton x:Name="SelectAllButton" Icon="SelectAll" Label="Select all" Click="SelectAllButton_Click"/>
            <AppBarButton x:Name="ViewButton" Icon="View" Label="View" IsEnabled="False" Click="ViewButton_Click"/>
            <AppBarButton x:Name="FileInfoButton" Label="File info" IsEnabled="False" Click="FileInfoButton_Click"/>
            <AppBarButton x:Name="SaveAsButton" Label="Save as" IsEnabled="False" Click="SaveAsButton_Click"/>
            <AppBarButton x:Name="ShareButton" Label="View link" IsEnabled="False" Click="ShareButton_Click"/>
            <AppBarButton x:Name="CopyButton" Label="Copy" IsEnabled="False" Click="CopyButton_Click"/>
            <AppBarButton x:Name="MoveButton" Label="Move" IsEnabled="False" Click="MoveButton_Click"/>
            <AppBarButton x:Name="DeleteButton" Label="Delete" IsEnabled="False" Click="DeleteButton_Click"/>
            <AppBarButton x:Name="PasteButton" Label="Paste" IsEnabled="False" Click="PasteButton_Click"/>
        </CommandBar>
        <Grid Grid.Row="2">
        <ListView x:Name="ItemsList" SelectionMode="Multiple" SelectionChanged="ItemsList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:DriveItem">
                        <Border Style="{StaticResource LiveDriveListRowStyle}" RightTapped="DriveItem_RightTapped">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <SymbolIcon Symbol="{x:Bind IsFolder, Converter={StaticResource BooleanToSymbolConverter}}"/>
                            <StackPanel Grid.Column="1" Margin="12,0">
                                <TextBlock Text="{x:Bind Name}" FontSize="16" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource LiveDriveMutedTextStyle}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel x:Name="UploadProgressPanel" VerticalAlignment="Top" Background="{ThemeResource CalloutBackgroundBrush}"
                        Padding="12" Margin="0,8,0,0" Visibility="Collapsed">
                <TextBlock x:Name="UploadProgressText" Text="Uploading file…" Margin="0,0,0,6"/>
                <ProgressBar x:Name="UploadProgress" Minimum="0" Maximum="1" Value="0"/>
            </StackPanel>
            <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <ProgressRing IsActive="True" Width="28" Height="28"/>
                <TextBlock Text="Loading your drive…" Style="{StaticResource LiveDriveStateDescriptionStyle}"/>
            </StackPanel>
            <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="This folder is empty." Style="{StaticResource LiveDriveStateTitleStyle}"/>
                <TextBlock Text="Use Upload to add a file from this phone." Style="{StaticResource LiveDriveStateDescriptionStyle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
