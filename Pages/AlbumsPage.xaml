<Page
    x:Class="LiveDrive.Pages.AlbumsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:LiveDrive.Models"
    xmlns:helpers="using:LiveDrive.Helpers">
    <Page.Resources>
        <helpers:ThumbnailConverter x:Key="ThumbnailConverter"/>
    </Page.Resources>
    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Albums" Style="{StaticResource LiveDrivePageTitleStyle}"/>
        <TextBlock Grid.Row="1" Text="LiveDrive albums sync with LiveDrive on your other devices, but do not appear as OneDrive albums."
                   TextWrapping="Wrap" Style="{StaticResource LiveDriveMutedTextStyle}" Margin="0,0,0,8"/>
        <CommandBar Grid.Row="2" DefaultLabelPosition="Right">
            <AppBarButton Icon="Add" Label="New album" Click="NewAlbumButton_Click"/>
            <AppBarButton Icon="Refresh" Label="Refresh" Click="RefreshButton_Click"/>
        </CommandBar>
        <Grid Grid.Row="3">
            <ListView ItemsSource="{x:Bind Albums}" IsItemClickEnabled="True" ItemClick="AlbumsList_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:PhotoAlbum">
                        <Border Style="{StaticResource LiveDriveListRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="60" Height="60">
                                    <SymbolIcon Symbol="Pictures" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"/>
                                    <Image Source="{Binding CoverThumbnailUrl, Converter={StaticResource ThumbnailConverter}}"
                                           Stretch="UniformToFill"/>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="12,0">
                                    <TextBlock Text="{x:Bind Name}" FontSize="17"/>
                                    <TextBlock Text="{x:Bind ItemCountLabel}" Style="{StaticResource LiveDriveMutedTextStyle}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="No LiveDrive albums yet." Style="{StaticResource LiveDriveStateTitleStyle}"/>
                <TextBlock Text="Create an album, then select photos to add from the Photos page."
                           Style="{StaticResource LiveDriveStateDescriptionStyle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
